<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImcMaui.NewFolder.MainPage"
             Title="Indice de la masa corporal">
    <ScrollView>
        <VerticalStackLayout
        Padding="24"
        Spacing="24">
            <Border
            Stroke="LightGray"
            StrokeThickness="2">

                <Border.StrokeShape>
                    <RoundRectangle
                        CornerRadius="10"/>
                </Border.StrokeShape>
                
                <VerticalStackLayout>

                    <Label
                    Text="Proporcione el peso en gramos"/>
                    <Entry
                    BackgroundColor="WhiteSmoke"
                        x:Name="PesoEntry"/>
                    <Label
                    Text="Proporcione estatura y metros"/>
                    <Entry
                    BackgroundColor="WhiteSmoke"
                        x:Name="EstaturaEntry"/>
                    
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout
            HorizontalOptions="Center"
            Spacing="24">

                <Button
                Text="Calcular"
                BackgroundColor="Green"
                    Clicked="OnCalcularButtonCliked"/>
                <Button
                Text="Limpiar"
                    
                    Clicked="OnLimpiarButtonCliked"/>
            </HorizontalStackLayout>

            <Border>
                <VerticalStackLayout
                    Padding="18"
                    Spacing="8">
                    <Label
                    Text="El indice de masa corporal es:"/>
                    <Label
                    Text="23.4567"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"
                        x:Name="ImcLabel"/>
                    <Label
                    Text="La situacion nutricional de la persona es:"/>
                    <Label
                    Text="Peso normal"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"
                    x:Name="SituacionNutricionalLabel"/>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

    </ScrollView>
 
</ContentPage>